{
  "name": "college-fees-backend",
  "version": "1.0.0",
  "description": "Express + Prisma Backend for College Fees Management ERP",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "postbuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('dist/index.js')) fs.writeFileSync('dist/index.js', 'require(\\\"./src/index.js\\\");');\"",
    "start": "node dist/src/index.js",
    "dev": "tsc -w",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:push:force": "prisma db push --accept-data-loss",
    "prisma:migrate": "prisma migrate dev",
    "seed": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pdf-lib": "^1.17.1",
    "prisma": "5.22.0",
    "puppeteer-core": "^25.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "prisma": "5.22.0",
    "supertest": "^7.2.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLERK
  STUDENT
  TEACHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum FeeHead {
  Tuition
  Hostel
  Transport
  Exam
  LateFee
  Other
}

enum PaymentMode {
  CASH
  CHEQUE
  DD
  ONLINE_PLACEHOLDER
}

enum TransactionStatus {
  SUCCESS
  REVERSED
}

enum BookIssueStatus {
  ISSUED
  RETURNED
  OVERDUE
}

enum FineStatus {
  PENDING
  PAID
  WAIVED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student               Student?
  teacher               Teacher?
  recordedTransactions  Transaction[] @relation("RecordedByClerk")
  attendanceSessions    AttendanceSession[] @relation("MarkedByTeacher")
  bookIssuesIssued      BookIssue[]   @relation("IssuedByStaff")
}

model Teacher {
  id              String   @id @default(cuid())
  userId          String   @unique
  employeeId      String   @unique
  subjectsTaught  String[]
  classesAssigned Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Student {
  id                 String             @id @default(cuid())
  userId             String             @unique
  rollNumber         String             @unique
  name               String
  class              String
  batch              String
  section            String             @default("A")
  admissionYear      Int
  contactNumber      String
  admissionDate      DateTime?          @default(now())
  admissionNumber    String?            @unique
  guardianName       String?
  guardianContact    String?
  guardianRelation   String?
  dateOfBirth        DateTime?
  gender             String?
  address            String?
  documentsSubmitted Json?
  photoUrl           String?
  status             StudentStatus      @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeAssignments     FeeAssignment[]
  transactions       Transaction[]
  attendanceRecords  AttendanceRecord[]
  bookIssues         BookIssue[]
}

model AttendanceSession {
  id                String             @id @default(cuid())
  class             String
  section           String
  date              DateTime           @db.Date
  subjectId         String?
  markedByTeacherId String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  markedByTeacher   User               @relation("MarkedByTeacher", fields: [markedByTeacherId], references: [id], onDelete: Restrict)
  records           AttendanceRecord[]

  @@unique([class, section, date])
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  attendanceSessionId String
  studentId           String
  status              AttendanceStatus
  remarks             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  session             AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, studentId])
}

model FeeStructure {
  id           String          @id @default(cuid())
  class        String
  batch        String
  academicYear String
  feeHead      FeeHead
  amount       Float
  dueDate      DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  feeAssignments FeeAssignment[]
}

model FeeAssignment {
  id             String          @id @default(cuid())
  studentId      String
  feeStructureId String
  createdAt      DateTime        @default(now())

  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure    @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([studentId, feeStructureId])
}

model Transaction {
  id                      String            @id @default(cuid())
  studentId               String
  feeAssignmentId         String
  amount                  Float
  paymentMode             PaymentMode
  referenceNumber         String
  recordedByClerkId       String
  receiptNumber           String            @unique
  status                  TransactionStatus @default(SUCCESS)
  reversalOfTransactionId String?           @unique
  reversalReason          String?
  createdAt               DateTime          @default(now())

  student                 Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  feeAssignment           FeeAssignment     @relation(fields: [feeAssignmentId], references: [id], onDelete: Restrict)
  recordedByClerk         User              @relation("RecordedByClerk", fields: [recordedByClerkId], references: [id], onDelete: Restrict)

  reversalOf              Transaction?      @relation("ReversalHistory", fields: [reversalOfTransactionId], references: [id])
  reversedBy              Transaction?      @relation("ReversalHistory")
}

model Book {
  id              String      @id @default(cuid())
  title           String
  author          String
  isbn            String      @unique
  category        String
  totalCopies     Int
  availableCopies Int
  addedAt         DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  issues          BookIssue[]
}

model BookIssue {
  id              String          @id @default(cuid())
  bookId          String
  studentId       String
  issuedByUserId  String
  issueDate       DateTime        @default(now())
  dueDate         DateTime
  returnDate      DateTime?
  status          BookIssueStatus @default(ISSUED)
  fineAmount      Float?
  fineStatus      FineStatus?
  finePaidAt      DateTime?
  fineWaivedAt    DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  book            Book            @relation(fields: [bookId], references: [id], onDelete: Restrict)
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  issuedByUser    User            @relation("IssuedByStaff", fields: [issuedByUserId], references: [id], onDelete: Restrict)
}
